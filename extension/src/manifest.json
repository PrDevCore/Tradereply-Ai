{
  "manifest_version": 3,
  "name": "PR Reply AI - Universal Auto-Reply",
  "version": "2.0.0",
  "description": "Sign in to PR Reply AI, connect any social platform URL (Facebook, Instagram, X, TikTok, LinkedIn, Checkatrade…), and get instant AI-drafted replies on that site.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "host_permissions": [
    "__TRADEREPLY_API_ORIGIN__/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PR Reply AI Assistant",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "88",
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.tiktok.com/*",
        "*://*.linkedin.com/*",
        "*://*.checkatrade.com/*",
        "*://*.mybuilder.com/*",
        "*://*.ratedpeople.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
